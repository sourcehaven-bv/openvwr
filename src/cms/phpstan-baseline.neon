	# Filament v5 deprecations, recorded rather than fixed.
	#
	# These are calls that still work in v5 but that Filament wants replaced:
	# mostly Placeholder, for which the successor (TextEntry with state()) renders
	# differently. Our call sites pass ->view() and ->content() with their own
	# blade views, so swapping them is a visual change across half the register --
	# not a mechanical rename, and not verifiable within the upgrade that
	# surfaced them. Recorded here so the upgrade is not blocked on it, and so the
	# work stays visible instead of being silently ignored.
		-
			message: '''
				#^Call to deprecated method form\(\) of class Filament\\Actions\\Action\:
				Use `schema\(\) instead\.$#
			'''
			identifier: method.deprecated
			count: 1
			path: /Users/jeroen/Work/sourcehaven/openvwr-fil5/src/cms/app/Filament/Actions/TransferExportBulkAction.php
		-
			message: '''
				#^Call to method content\(\) of deprecated class Filament\\Forms\\Components\\Placeholder\:
				Use `TextEntry` with the `state\(\)` method instead\.$#
			'''
			identifier: method.deprecatedClass
			count: 1
			path: /Users/jeroen/Work/sourcehaven/openvwr-fil5/src/cms/app/Filament/Actions/TransferExportBulkAction.php
