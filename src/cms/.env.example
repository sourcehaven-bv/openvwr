APP_ENV=local
APP_KEY=
APP_URL=http://localhost
APP_DEBUG=true
APP_SERVICE=web

LOG_LEVEL=debug

DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_SECURE_COOKIE=false
SESSION_COOKIE=verwerkingsregister_session

VIRUSSCANNER_SOCKET=tcp://clamav:3310

OUTBOX_SMTP_FROM=hello@example.com
QUEUE_CONNECTION=sync
IP_WHITELIST_DEFAULTS=*.*.*.*
ONE_TIME_PASSWORD_DRIVER=fake

# How identity is established:
#   builtin  passwordless magic link + TOTP (the default; what production uses)
#   dev      pick a user from a dropdown, no credentials — local/testing ONLY,
#            and the app refuses to boot with it in any other environment
#   pratique identity comes from the Pratique proxy's signed assertion
AUTH_DRIVER=builtin

# Optional features. Every flag defaults to true, so leaving it unset keeps the
# behaviour an existing deployment already has. Switching a flag off only hides
# the user interface; the underlying data, jobs and exports keep working.
# Set to false for a tenant that does not publish to a public website: this hides
# the "Publiceren" step, the public-from fields and the static website links.
# FEATURE_PUBLISHING=true
# Set to false for a tenant that does not keep a WPG register: this hides the
# "WPG verantwoordelijke" register, its lookup list and its dashboard entries.
# FEATURE_WPG=true

# Only used when AUTH_DRIVER=pratique. The audience MUST equal the proxy's
# upstream.audience exactly: a mismatch is the usual cause of an endless 403
# loop, and a lenient check would accept assertions minted for another app.
# PRATIQUE_ISSUER=https://auth.example.com
# PRATIQUE_AUDIENCE=app://openvwr
# PRATIQUE_JWKS_URL=https://auth.example.com/.well-known/pratique/jwks.json
# PRATIQUE_JWKS_CACHE_SECONDS=300
# PRATIQUE_LEEWAY_SECONDS=60
#
# Lifecycle events are received at POST /pratique/webhook, registered only under
# this driver. Point the proxy's webhooks.endpoints there and subscribe to
# session.revoked and membership.*. The endpoint is unauthenticated by necessity
# (the proxy holds no session), so it verifies the ES256 signature over the whole
# request body instead — it needs an upstream.public_paths entry on the proxy
# side. Entirely optional: everything an event reports is reconciled on the
# user's next request anyway, so a missed delivery costs promptness, never
# correctness.

# Static Website Configuration
# Base URL where the static website will be accessible
STATIC_WEBSITE_BASE_URL=http://localhost:8080
STATIC_WEBSITE_PORT=8080
# Directory where Hugo will output the built static website (served by nginx)
HUGO_OUTPUT_DIR=/var/www/html/storage/app/static-website
# Root directory of the Hugo project (where build.sh, themes, layouts are located)
FILESYSTEM_STATIC_WEBSITE_ROOT=/var/www/html/static-website

# Root for the media-library (uploads), filament (exports) and transfer disks when
# they run on the local driver. Defaults to storage_path('app/shared-storage'),
# which is correct for local dev and CI alike. Set this only in a deployment that
# keeps the directory outside the release dir, so uploads survive releases and stay
# in sync across nodes.
# FILESYSTEM_SHARED_STORAGE_PATH=/srv/openvwr/shared-storage

# Object storage (opt-in). Leave unset to keep the shared disks on the local
# filesystem. Set to "s3" to move uploads, exports and transfer bundles to an
# S3-compatible bucket; the AWS_* settings below then apply and the buckets must
# exist (`php artisan storage:setup-buckets`). See docs/object_storage.md.
# For Docker: `just minio-up`. Docker-less: `just setup-native-object-storage`.
# FILESYSTEM_SHARED_DRIVER=s3

# MinIO defaults for local development; a real deployment points these at its own
# endpoint and credentials.
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# AWS_ENDPOINT=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_DEFAULT_REGION=eu-central-1
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Bucket names, one per shared disk. Defaults match the disk purpose.
# UPLOADS_BUCKET=uploads
# EXPORTS_BUCKET=exports
# TRANSFER_BUCKET=transfer

AUDIT_SYSLOG_BASE64_ENCODE_ENABLED=false

# Banner shown at the top of every page, including the login page. Intended for
# environment-level notices; leave unset to disable. Level sets the colour and is
# one of info, warning (default) or danger. Plain text only.
# APP_BANNER_MESSAGE="This is a demo env. Do not put production content here."
# APP_BANNER_LEVEL=warning
