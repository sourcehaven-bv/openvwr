APP_ENV=local
APP_KEY=
APP_URL=http://127.0.0.1:8000
APP_DEBUG=true
APP_SERVICE=web

LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=openvwr_local
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_SECURE_COOKIE=false
SESSION_COOKIE=verwerkingsregister_session

VIRUSSCANNER_SOCKET=

OUTBOX_SMTP_FROM=hello@example.com
# Database-queue i.p.v. sync: Filament stuurt de export-voltooiingsmelding
# alleen als databasemelding op een echte queue. Vereist `php artisan queue:work`.
QUEUE_CONNECTION=database
IP_WHITELIST_DEFAULTS=*.*.*.*
# Accept any OTP code: avoids TOTP clock skew and the 3-attempt rate limit
# during scripted capture runs. Use "timed" to exercise real 2FA.
ONE_TIME_PASSWORD_DRIVER=fake

# Static Website Configuration
# Base URL where the static website will be accessible
STATIC_WEBSITE_BASE_URL=http://localhost:8080
STATIC_WEBSITE_PORT=8080
# Directory where Hugo will output the built static website (served by nginx)
HUGO_OUTPUT_DIR=/var/www/html/storage/app/static-website
# Root directory of the Hugo project (where build.sh, themes, layouts are located)
FILESYSTEM_STATIC_WEBSITE_ROOT=/var/www/html/static-website

# Configure bucket names for the disks, the same Minio/AWS configuration is used for both buckets.
UPLOADS_BUCKET=uploads
EXPORTS_BUCKET=exports

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=eu-central-1
MINIO_BUCKET=verwerkingsregister

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=verwerkingsregister
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

AUDIT_SYSLOG_BASE64_ENCODE_ENABLED=false


# --- Local (Docker-less) overrides ---
VIRUSSCANNER_DEFAULT=fake
MAIL_MAILER=log
# Debug toolbar off: it renders over the UI in screenshots.
DEBUGBAR_ENABLED=false

# Exports naar lokale schijf; standaard is dit een S3-disk die MinIO verwacht.
FILAMENT_FILESYSTEM_DISK=app
