APP_ENV=local
APP_KEY=
APP_URL=http://127.0.0.1:8000
APP_DEBUG=true
APP_SERVICE=web

LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=openvwr_local
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_SECURE_COOKIE=false
SESSION_COOKIE=verwerkingsregister_session

VIRUSSCANNER_SOCKET=

OUTBOX_SMTP_FROM=hello@example.com
# Database-queue i.p.v. sync: Filament stuurt de export-voltooiingsmelding
# alleen als databasemelding op een echte queue. Vereist `php artisan queue:work`.
QUEUE_CONNECTION=database
IP_WHITELIST_DEFAULTS=*.*.*.*
# Accept any OTP code: avoids TOTP clock skew and the 3-attempt rate limit
# during scripted capture runs. Use "timed" to exercise real 2FA.
ONE_TIME_PASSWORD_DRIVER=fake

# Static Website Configuration
# Base URL where the static website will be accessible
STATIC_WEBSITE_BASE_URL=http://localhost:8080
STATIC_WEBSITE_PORT=8080
# De statische website valt buiten deze setup (de CMS-UI werkt zonder). Wil je
# hem toch lokaal genereren, zet dan HUGO_OUTPUT_DIR op een absoluut pad in je
# eigen checkout: build.sh valt terug op /var/www/html/storage/app/static-website,
# dat buiten de containers niet bestaat.
# HUGO_OUTPUT_DIR=/pad/naar/openvwr/src/cms/storage/app/static-website
#
# FILESYSTEM_STATIC_WEBSITE_ROOT hoeft niet gezet: config/filesystems.php
# gebruikt standaard al storage_path('app/static-website').

AUDIT_SYSLOG_BASE64_ENCODE_ENABLED=false

# Object storage (opt-in). Zonder deze regels staan uploads, exports en
# transfer-bundles gewoon op de lokale schijf, wat voor de meeste lokale
# ontwikkeling prima is. `just setup-native-object-storage` installeert minio en
# zet deze waarden automatisch. Zie docs/object_storage.md.
# FILESYSTEM_SHARED_DRIVER=s3
# AWS_ENDPOINT=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_DEFAULT_REGION=eu-central-1
# AWS_USE_PATH_STYLE_ENDPOINT=true


# --- Local (Docker-less) overrides ---
VIRUSSCANNER_DEFAULT=fake
MAIL_MAILER=log
# Debug toolbar off: it renders over the UI in screenshots.
DEBUGBAR_ENABLED=false

# De uploads-, exports- en transfer-disks staan standaard lokaal
# (storage/app/shared-storage). Objectopslag is optioneel; zie hierboven.
